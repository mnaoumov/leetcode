<Project>

  <!--
  Every project builds in one of two configurations:
  WIP  (default) - LeetCode.Problems compiles only the working set in !WIP, so the IDE and test runs stay fast.
  Full           - LeetCode.Problems compiles every problem.
  Both are debug builds; the other projects build the same in either.
  -->
  <PropertyGroup>
    <Configurations>WIP;Full</Configurations>
    <Configuration Condition="'$(Configuration)' == ''">WIP</Configuration>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <OutputType>Library</OutputType>
    <RootNamespace>LeetCode</RootNamespace>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-all</AnalysisLevel>
<!--
CA1002: Change List<T> to Collection<T> (template code)
CA1034: Do not nest type (template code, public for testability)
CA1062: Validate arguments of public methods
CA1515: Consider making public types internal
CA1707: Identifiers should not contain underscores
CA1819: Properties should not return arrays
CA2100: Review SQL queries for security vulnerabilities
CA2225: Provide alternate method for operator (template code)
-->
    <NoWarn>CA1002;CA1034;CA1062;CA1515;CA1707;CA1812;CA1819;CA2100;CA2225</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jering.Javascript.NodeJS" />
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="LocalDb" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.NETCore.Platforms" />

    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <!-- WIP compiles only the working set in Problems\!TODO; Full compiles every problem (see Directory.Build.props). -->
  <ItemGroup Condition="'$(Configuration)' != 'Full'">
    <Compile Remove="Problems\**\*.cs" />
    <None Remove="Problems\**\*" />
    <Content Remove="Problems\**\*" />
    <Compile Include="Problems\!TODO\**\*.cs" />
    <None Include="Problems\!TODO\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="**\*.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="**\*.sh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="**\*.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="JavaScript\Debugger.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Problems\!TODO\" />
  </ItemGroup>

  <Target Name="GatherJsonAnalyzers">
    <ItemGroup>
      <_JsonAnalyzers Include="@(Analyzer)" Condition=" '%(Analyzer.Filename)' == 'System.Text.Json.SourceGeneration' " />
    </ItemGroup>
  </Target>
  <Target Name="RemoveJsonAnalyzers" BeforeTargets="CoreCompile" DependsOnTargets="GatherJsonAnalyzers">
    <ItemGroup>
      <Analyzer Remove="@(_JsonAnalyzers)" />
    </ItemGroup>
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <OutputType>Library</OutputType>
    <RootNamespace>LeetCode</RootNamespace>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-all</AnalysisLevel>
<!--
CA1002: Change List<T> to Collection<T> (template code)
CA1034: Do not nest type (template code, public for testability)
CA1062: Validate arguments of public methods
CA1515: Consider making public types internal
CA1707: Identifiers should not contain underscores
CA1819: Properties should not return arrays
CA2100: Review SQL queries for security vulnerabilities
CA2225: Provide alternate method for operator (template code)
-->
    <NoWarn>CA1002;CA1034;CA1062;CA1515;CA1707;CA1812;CA1819;CA2100;CA2225</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jering.Javascript.NodeJS" />
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="LocalDb" />
    <PackageReference Include="NUnit" />
  </ItemGroup>

  <!-- The framework was one assembly with the problems until it was split off; its internals stay theirs. -->
  <ItemGroup>
    <InternalsVisibleTo Include="LeetCode.Problems" />
    <InternalsVisibleTo Include="LeetCode.Framework.Tests" />
    <InternalsVisibleTo Include="TestCaseExporter" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="JetBrains.Annotations" />
    <Using Include="LeetCode.Base" />
    <Using Include="LeetCode.ClassDesign" />
    <Using Include="LeetCode.DataStructure" />
    <Using Include="LeetCode.Helpers" />
    <Using Include="LeetCode.JavaScript" />
    <Using Include="LeetCode.Sql" />
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <None Update="**\*.json;**\*.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="JavaScript\Debugger.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="GatherJsonAnalyzers">
    <ItemGroup>
      <_JsonAnalyzers Include="@(Analyzer)" Condition=" '%(Analyzer.Filename)' == 'System.Text.Json.SourceGeneration' " />
    </ItemGroup>
  </Target>
  <Target Name="RemoveJsonAnalyzers" BeforeTargets="CoreCompile" DependsOnTargets="GatherJsonAnalyzers">
    <ItemGroup>
      <Analyzer Remove="@(_JsonAnalyzers)" />
    </ItemGroup>
  </Target>
</Project>

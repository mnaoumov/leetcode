<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <OutputType>Library</OutputType>
    <RootNamespace>LeetCode.Problems</RootNamespace>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-all</AnalysisLevel>
<!--
CA1002: Change List<T> to Collection<T> (template code)
CA1034: Do not nest type (template code, public for testability)
CA1062: Validate arguments of public methods
CA1515: Consider making public types internal
CA1707: Identifiers should not contain underscores
CA1819: Properties should not return arrays
CA2100: Review SQL queries for security vulnerabilities
CA2225: Provide alternate method for operator (template code)
-->
    <NoWarn>CA1002;CA1034;CA1062;CA1515;CA1707;CA1812;CA1819;CA2100;CA2225</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.NETCore.Platforms" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LeetCode.Framework\LeetCode.Framework.csproj" />
  </ItemGroup>

  <!-- WIP compiles only the working set in !WIP; Full compiles every problem (see Directory.Build.props). -->
  <ItemGroup Condition="'$(Configuration)' != 'Full'">
    <Compile Remove="*\**\*.cs" />
    <None Remove="*\**\*" />
    <Content Remove="*\**\*" />
    <Compile Include="!WIP\**\*.cs" />
    <None Include="!WIP\**\*" />
  </ItemGroup>

  <!-- Test cases and scripts are copied under Problems\ in the output, where TestsBase looks for them. -->
  <ItemGroup>
    <None Update="**\*.json;**\*.sql;**\*.sh;**\*.js">
      <Link>Problems\%(Identity)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="GatherJsonAnalyzers">
    <ItemGroup>
      <_JsonAnalyzers Include="@(Analyzer)" Condition=" '%(Analyzer.Filename)' == 'System.Text.Json.SourceGeneration' " />
    </ItemGroup>
  </Target>
  <Target Name="RemoveJsonAnalyzers" BeforeTargets="CoreCompile" DependsOnTargets="GatherJsonAnalyzers">
    <ItemGroup>
      <Analyzer Remove="@(_JsonAnalyzers)" />
    </ItemGroup>
  </Target>
</Project>
